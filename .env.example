# Copy to .env and adjust. Docker compose reads this file.

# Port the app listens on inside the container (and on the host via compose).
PORT=3000

# REQUIRED. Signs session cookies. At least 32 characters; the server refuses to start without it.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Timezone for "today", month boundaries and the 03:00 nightly backup.
TZ=Europe/Athens

# Where the database, receipt photos and backups live. /data is the Docker volume.
DATA_DIR=/data

# Secure cookies: "auto" (default) = secure when the request came over HTTPS (directly or via a
# proxy such as Caddy or Tailscale). Use "true" to always require HTTPS, "false" for plain HTTP on a LAN.
COOKIE_SECURE=auto
